-- G1 function v0.1

local G1 = {}

function G1.UICorner(Parent,Val)
    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = Val
    UICorner.Parent = Parent
    return UICorner
end

function G1.UILine(Parent,Value,Color)
    local UILine = Instance.new("UIStroke")
    UILine.Color = Color
    UILine.Thickness = Value
    UILine.Parent = Parent
    return UILine
end

function G1.TweenPosition(ui, dur, pos)
	game:GetService("TweenService"):Create(ui, TweenInfo.new(dur), {Position = pos}):Play()
end

function G1.TweenTransparency (ui, dur, trans)
	game:GetService("TweenService"):Create(ui, TweenInfo.new(dur), {BackgroundTransparency = trans}):Play()
end

function G1.TweenSize(ui, dur, size)
	game:GetService("TweenService"):Create(ui, TweenInfo.new(dur), {Size = size}):Play()
end

function G1.UIGradient(parent, color1, color2, rot)
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, color1),
		ColorSequenceKeypoint.new(1, color2)
	})
	gradient.Rotation = rot
	gradient.Parent = parent
	return gradient
end

function G1.Drag(p,s)
local d,i,s1,p0
local function u(x)
	if not d then return end
	local o=x.Position-s1
	local n=UDim2.new(p0.X.Scale,p0.X.Offset+o.X,p0.Y.Scale,p0.Y.Offset+o.Y)
	TweenService:Create(p,TweenInfo.new(s,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Position=n}):Play()
end
p.InputBegan:Connect(function(x)
	if x.UserInputType==Enum.UserInputType.MouseButton1 or x.UserInputType==Enum.UserInputType.Touch then
		d=true s1=x.Position p0=p.Position
		x.Changed:Connect(function() if x.UserInputState==Enum.UserInputState.End then d=false end end)
	end
end)
p.InputChanged:Connect(function(x)
	if x.UserInputType==Enum.UserInputType.MouseMovement or x.UserInputType==Enum.UserInputType.Touch then i=x end
end)
UserInputService.InputChanged:Connect(function(x) if x==i and d then u(x) end end)

end

return G1
