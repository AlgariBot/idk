local G1 = {}

function G1.UICorner(Parent,Val)
    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = Val
    UICorner.Parent = Parent
    return UICorner
end

function G1.UILine(Parent,Value,Color)
    local UILine = Instance.new("UIStroke")
    UILine.Color = Color
    UILine.Thickness = Value
    UILine.Parent = Parent
    return {UILine}
end

function G1.TweenPosition(ui, dur, pos)
	game:GetService("TweenService"):Create(ui, TweenInfo.new(dur), {Position = pos}):Play()
end

function G1.TweenTransparency (ui, dur, trans)
	game:GetService("TweenService"):Create(ui, TweenInfo.new(dur), {BackgroundTransparency = trans}):Play()
end

function G1.TweenSize(ui, dur, size)
	game:GetService("TweenService"):Create(ui, TweenInfo.new(dur), {Size = size}):Play()
end

function G1.UIGradient(parent, color1, color2, rot)
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, color1),
		ColorSequenceKeypoint.new(1, color2)
	})
	gradient.Rotation = rot
	gradient.Parent = parent
	return gradient
end
  
function G1.Drag(Placeholder,speed)  
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local dragging = false  
local dragInput  
local dragStart  
local startPos  
  
local function update(input)  
	if not dragging then return end  
	local delta = input.Position - dragStart  
	local newPos = UDim2.new(  
		startPos.X.Scale, startPos.X.Offset + delta.X,  
		startPos.Y.Scale, startPos.Y.Offset + delta.Y  
	)  
  
	TweenService:Create(Placeholder, TweenInfo.new(speed, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {  
		Position = newPos  
	}):Play()  
end  
  
Placeholder.InputBegan:Connect(function(input)  
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then  
		dragging = true  
		dragStart = input.Position  
		startPos = Placeholder.Position  
		input.Changed:Connect(function()  
			if input.UserInputState == Enum.UserInputState.End then  
				dragging = false  
			end  
		end)  
	end  
end)  
  
Placeholder.InputChanged:Connect(function(input)  
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then  
		dragInput = input  
	end  
end)  
  
UserInputService.InputChanged:Connect(function(input)  
	if input == dragInput and dragging then  
		update(input)  
	end  
end)  
end

function G1.SendKey(key)
	game:GetService("VirtualInputManager"):SendKeyEvent(true,key,false,game)
end

return G1

function G1.UIGrow(data)  
	local obj = data.parent
	obj.AnchorPoint = Vector2.new(0.5, 0.5)    
	obj.MouseEnter:Connect(function()    
	obj:TweenSize(data.growsize, "Out", "Linear", 0.1, true)    
	end)    
    
	obj.MouseLeave:Connect(function()    
		obj:TweenSize(data.normalsize, "Out", "Linear", 0.1, true)    
	end)  
en
